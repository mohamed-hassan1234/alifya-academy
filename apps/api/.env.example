# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (set to 1 behind nginx / a load balancer)
TRUST_PROXY=0

# ---- Database ----
# Transactions require a replica set (or MongoDB Atlas). Single-node replica set for local dev:
#   mongod --replSet rs0  then  mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://127.0.0.1:27017/alifya?replicaSet=rs0

# ---- Web / CORS ----
WEB_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Defaults to true in production; must stay true there.
# COOKIE_SECURE=false

# ---- Email ----
# console = print emails to the API log (development only; refused in production)
# smtp    = real delivery via any SMTP provider
EMAIL_PROVIDER=console
EMAIL_FROM="Alifya Academy <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- First Super Administrator (used by `npm run seed` only) ----
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME="Super Administrator"
