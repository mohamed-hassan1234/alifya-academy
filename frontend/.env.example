# ------------------------------------------------------------------------------------------------
# Frontend (Vite) development settings. Copy to frontend/.env (`npm run setup` does this for you).
#
# The browser app always calls the API on the SAME origin at /api/v1. During development Vite proxies
# /api to the backend; in production your web server / reverse proxy does the same. This keeps the
# refresh-token cookie first-party (SameSite) — so there is intentionally no VITE_API_URL.
#
# Never put secrets here: frontend values end up in the browser.
# ------------------------------------------------------------------------------------------------

# Port of the Vite dev server (npm run dev)
WEB_PORT=5173

# Port of the backend API that /api is proxied to (must match PORT in backend/.env)
API_PORT=4000

# Optional: full proxy target instead of API_PORT, e.g. a backend on another machine
# API_PROXY_TARGET=http://localhost:4000

# Port of `npm run preview` (production build preview)
PREVIEW_PORT=4173
