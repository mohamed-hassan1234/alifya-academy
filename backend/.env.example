# ------------------------------------------------------------------------------------------------
# Backend (Express API) configuration. Copy to backend/.env — `npm run setup` does this for you and
# fills JWT_ACCESS_SECRET with a freshly generated random value. Never commit backend/.env.
# Every value is validated at startup (src/config/env.ts); the API refuses to start on invalid config.
# ------------------------------------------------------------------------------------------------

# ---- Runtime ----
# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (set to 1 behind nginx / a load balancer)
TRUST_PROXY=0

# ---- Database ----
# A MongoDB REPLICA SET is required (the API uses transactions). Options:
#   - `npm run db:dev` (bundled single-node replica set on 127.0.0.1:27017, development only)
#   - your own mongod:  mongod --replSet rs0   then   mongosh --eval "rs.initiate()"
#   - MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster>/alifya
MONGODB_URI=mongodb://127.0.0.1:27017/alifya?replicaSet=rs0

# ---- Web / CORS ----
# Comma-separated browser origins allowed to call the API
WEB_ORIGINS=http://localhost:5173
# Public URL of the web app (used in links inside emails)
APP_URL=http://localhost:5173

# ---- Auth ----
# REQUIRED, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Defaults to true in production; must stay true there.
# COOKIE_SECURE=false

# ---- Email ----
# console = print emails to the API log (development only; refused in production)
# smtp    = real delivery via any SMTP provider
EMAIL_PROVIDER=console
EMAIL_FROM="Alifya Academy <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- File storage ----
# Local disk driver (relative to backend/). An S3-compatible driver is planned (see docs/KNOWN_BLOCKERS.md).
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# ---- First Super Administrator (optional; read by `npm run seed` only) ----
# Leave empty and run `npm run admin:create` instead to enter the credentials interactively (hidden input).
# The password is never printed, and an EXISTING account's password is never changed by the seed.
# Password rules: 10–128 characters, containing at least one letter and one number.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME="Super Administrator"
